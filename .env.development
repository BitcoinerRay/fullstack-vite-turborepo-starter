VITE_BACKEND_URL=http://localhost:4000

PORT=4000
ENABLE_SWAGGER=true
FRONTEND_HOST=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nest_boilerplate
REDIS_URL=redis://:redis_pass@127.0.0.1:6379

# Local-only dev secret. Override per environment; never reuse in production.
JWT_SECRET=local-dev-secret-replace-me-with-openssl-rand-base64-48
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
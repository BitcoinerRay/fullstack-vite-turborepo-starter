{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.development", ".env.production", "**/.env.*local"],
  "tasks": {
    "db:generate": {
      "cache": false,
      "outputs": ["node_modules/.prisma/client/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig*.json", "package.json", "vite.config.ts", "nest-cli.json"],
      "outputs": ["dist/**"]
    },
    "type-check": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig*.json", "package.json"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig*.json", "xo.config.*", ".eslintrc*", "package.json"],
      "outputs": []
    },
    "lint:fix": {
      "cache": false
    },
    "format": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start:dev": {
      "cache": false,
      "persistent": true
    },
    "start:prod": {
      "cache": false,
      "persistent": true
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "tsconfig*.json", "package.json", "jest*.json"],
      "outputs": []
    },
    "test:unit:cov": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "tsconfig*.json", "package.json", "jest*.json"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "test/**",
        "tests/**",
        "tsconfig*.json",
        "package.json",
        "playwright.config.*",
        "jest*.json"
      ],
      "outputs": []
    }
  }
}

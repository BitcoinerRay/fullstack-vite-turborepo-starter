{
  "name": "next-nest-turbo-boilerplate",
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "infra:start": "node scripts/infra-start.js",
    "infra:stop": "docker compose down",
    "infra:restart": "docker compose down && node scripts/infra-start.js",
    "infra:logs": "docker compose logs -f",
    "infra:ps": "docker compose ps",
    "infra:health": "docker compose ps",
    "dev": "turbo run dev --parallel",
    "dev:all": "npm run infra:start && npm run dev",
    "build": "turbo run build",
    "start:dev": "turbo run start:dev",
    "start:prod": "turbo run start:prod",
    "lint": "turbo run lint --",
    "lint:fix": "turbo run lint:fix --",
    "type-check": "turbo run type-check",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "test:unit:cov": "turbo run test:unit:cov",
    "test:all": "turbo run test:unit test:e2e",
    "ci": "turbo run lint type-check test:unit:cov build",
    "format": "prettier --write \"**/*.{json,md,css,html,yml,yaml}\"",
    "init": "node scripts/init.js",
    "copilot:sync": "node scripts/copilot-sync.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "20.4.1",
    "@commitlint/config-conventional": "20.4.1",
    "cross-env": "^10.1.0",
    "husky": "9.1.7",
    "inquirer": "^13.3.0",
    "lint-staged": "16.2.7",
    "prettier": "3.8.1",
    "ts-node": "10.9.2",
    "turbo": "2.8.7"
  },
  "overrides": {
    "@nestjs/common": "11.1.18",
    "@nestjs/core": "11.1.18",
    "@nestjs/platform-express": "11.1.18",
    "file-type": "21.3.4",
    "handlebars": "4.7.9",
    "lodash": "4.18.1",
    "minimatch": "10.2.5",
    "multer": "2.1.1",
    "path-to-regexp": "8.4.2",
    "picomatch": "4.0.4",
    "rollup": "4.60.1",
    "serialize-javascript": "7.0.5",
    "undici": "7.24.7",
    "yaml": "2.8.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.10.0"
}

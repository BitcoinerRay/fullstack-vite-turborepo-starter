# Copy this file to `.env.production` and fill in real values.
# `.env.production` is git-ignored — it must NEVER be committed.

VITE_BACKEND_URL=https://api.example.com

PORT=5000
ENABLE_SWAGGER=false
FRONTEND_HOST=https://example.com

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
REDIS_URL=redis://:PASSWORD@HOST:6379

# REQUIRED. Generate with: openssl rand -base64 48
JWT_SECRET=
# Access-token TTL (e.g. 15m). Refresh tokens use REFRESH_TOKEN_EXPIRES_IN.
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
# bcrypt work factor; raise for stronger hashing at the cost of CPU.
BCRYPT_SALT_ROUNDS=12
